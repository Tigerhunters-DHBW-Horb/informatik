<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:views="using:Kontrollzentrum.Views"
    x:Class="Kontrollzentrum.Views.MainWindow"
    Title="Kontrollzentrum"
    Width="1100"
    Height="720"
    MinWidth="700"
    MinHeight="600"
    WindowStartupLocation="Manual"
    Background="{DynamicResource WindowBackground}">

    <!-- Farben und Maße zentral definieren -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackground">#F5F3F0</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#0B0B23</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#5C6078</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentColor">#51483D</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentForeground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBorder">#EAE8E5</SolidColorBrush>
                    <SolidColorBrush x:Key="Divider">#EEECE9</SolidColorBrush>
                    <SolidColorBrush x:Key="CardDark">#08071E</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHoverBackground">#EAE7E3</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver">#E6E6E6</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#97A59A</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver">#525353</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked">Transparent</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver">Transparent</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackground">#1B1A18</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#F5F5FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#B8B8CC</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentColor">#756858</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentForeground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackground">#362E22</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBorder">#51463A</SolidColorBrush>
                    <SolidColorBrush x:Key="Divider">#4A4138</SolidColorBrush>
                    <SolidColorBrush x:Key="CardDark">#08071E</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHoverBackground">#493E33</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBackground">#362E22</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver">#493E33</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#756858</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver">#B8A88E</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked">Transparent</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver">Transparent</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>

        <!-- Das Menü selbst bekommt keinen sichtbaren Rahmen -->
        <Style Selector="ListBox.sidebar-menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Grundzustand eines Menüeintrags -->
        <Style Selector="ListBox.sidebar-menu ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />

            <!-- Eigenes Template: kein Standard-Auswahlbalken -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="12">

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Maus über einem Menüeintrag -->
        <Style Selector="ListBox.sidebar-menu ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBackground}" />
        </Style>

        <!-- Ausgewählter Menüeintrag -->
        <Style Selector="ListBox.sidebar-menu ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SidebarSelectedBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Einheitliche Größe für die vorläufigen Menüsymbole -->
        <Style Selector="TextBlock.menu-icon">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

    </Window.Styles>

    <!-- Links feste Breite, rechts verbleibender Platz -->
    <Grid ColumnDefinitions="220,*">

        <!-- Seitenleiste -->
        <Grid
            Grid.Column="0"
            Margin="20,26,12,22"
            RowDefinitions="Auto,*,Auto">

            <!-- Logo -->
            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="10"
                Margin="8,0,0,30">

                <Border
                    Width="50"
                    Height="50"
                    CornerRadius="11"
                    Background="{DynamicResource AccentColor}">

                    <icons:MaterialIcon Kind="BowArrow" Width="35" Height="35" Foreground="{DynamicResource AccentForeground}" />

                    <!-- <TextBlock
                    Text="TH"
                    Foreground="White"
                    FontSize="21"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" /> -->



                </Border>

                <TextBlock
                    Text="Tigerhunters"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    VerticalAlignment="Center" />

            </StackPanel>

            <!-- Navigation -->
            <ListBox
                x:Name="SidebarMenu"
                Grid.Row="1"
                Classes="sidebar-menu"
                SelectedIndex="0"
                VerticalAlignment="Top"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBoxItem>
                    <Grid ColumnDefinitions="24,*">
                        <icons:MaterialIcon Kind="ViewDashboard" Width="20"/>
                        <TextBlock
                            Grid.Column="1"
                            Text="Übersicht"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"/>
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>

                    <Grid ColumnDefinitions="24,*">
                        <icons:MaterialIcon Kind="Camera" Width="20" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Datenempfang"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>
                    <Grid ColumnDefinitions="24,*">
                        <icons:MaterialIcon Kind="SoccerField" Width="20" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Feld"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>
                    <Grid ColumnDefinitions="24,*">
                        <TextBlock Classes="menu-icon" Text="3" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Unterpunkt 3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </ListBoxItem>

                <!-- <ListBoxItem>
                <Grid ColumnDefinitions="24,*">
                <TextBlock Classes="menu-icon" Text="≡" />
                <TextBlock
                Grid.Column="1"
                Text="Reports"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
                </Grid>
                </ListBoxItem>

                <ListBoxItem>
                <Grid ColumnDefinitions="24,*">
                <TextBlock Classes="menu-icon" Text="✎" />
                <TextBlock
                Grid.Column="1"
                Text="Logbook"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
                </Grid>
                </ListBoxItem>

                <ListBoxItem>
                <Grid ColumnDefinitions="24,*">
                <TextBlock Classes="menu-icon" Text="?" />
                <TextBlock
                Grid.Column="1"
                Text="Help"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
                </Grid>
                </ListBoxItem>

                <ListBoxItem>
                <Grid ColumnDefinitions="24,*">
                <TextBlock Classes="menu-icon" Text="⚙" />
                <TextBlock
                Grid.Column="1"
                Text="Settings"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
                </Grid>
                </ListBoxItem> -->

            </ListBox>

            <Border
                Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="2"
                CornerRadius="16"
                HorizontalAlignment="Left"
                Padding="4">
                <ToggleButton
                    x:Name="ThemeSwitch"
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid>
                        <icons:MaterialIcon
                            x:Name="DarkThemeIcon"
                            Kind="MoonWaningCrescent"
                            Width="24"
                            Height="24"
                            Foreground="{DynamicResource TextPrimary}"
                            IsVisible="False" />
                        <icons:MaterialIcon
                            x:Name="LightThemeIcon"
                            Kind="WhiteBalanceSunny"
                            Width="24"
                            Height="24"
                            Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                </ToggleButton>

            </Border>

        </Grid>

        <!-- Hier kommt später der Seiteninhalt hin -->
        <ContentControl
            x:Name="PageContent"
            Grid.Column="1"
            Margin="20,30,30,22"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

    </Grid>

</Window>