<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Kontrollzentrum.Views.ÜbersichtView">

    <Grid
          ColumnDefinitions="*,*,*"
          RowDefinitions="*,*"
          ShowGridLines="false">
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="12"
            Padding="18"
            Background="White"
            BorderBrush="#EAE8E5"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock
                        Text="Datenempfang"
                        FontSize="14"
                        Foreground="{StaticResource TextSecondary}" />
                    <TextBlock
                        Text="grSim / SSL-Vision"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <Border Height="1" Background="#EEECE9" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Zeit"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Pakete/s"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="KB/s"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="12"
            Padding="18"
            Background="White"
            BorderBrush="#EAE8E5"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,*">
                    <TextBlock
                        Grid.Column="0"
                        Text="Kalman Filter"
                        FontSize="14"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="False"
                        OnContent=""
                        OffContent=""
                        Margin="0,0,-100,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="#EEECE9" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Zeit"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Pakete/s"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="KB/s"
                        Foreground="{StaticResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Feld 3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Feld 4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Feld 5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Feld 6" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
    </Grid>

</UserControl>