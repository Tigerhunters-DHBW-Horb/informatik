<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kontrollzentrum.ViewModels"
    x:Class="Kontrollzentrum.Views.ÜbersichtView"
    x:DataType="vm:ÜbersichtViewModel">

    <Grid
        ColumnDefinitions="*,*,*"
        RowDefinitions="*,*"
        ShowGridLines="false">
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="12"
            Padding="18"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            Effect="{Binding BorderEffect}"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock
                        Text="Datenempfang"
                        FontSize="14"
                        Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock
                        Text="grSim / SSL-Vision"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Divider}" />

                <Grid
                    ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="16"
                    RowSpacing="10">

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Multicast-Adresse"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="UDP-Port"
                        VerticalAlignment="Center" />

                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Zeit"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Pakete/s"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding PacketsPerSecond}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="KB/s"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text=""
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="12"
            Padding="18"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,*">
                    <TextBlock
                        Grid.Column="0"
                        Text="Kalman Filter"
                        FontSize="14"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="False"
                        OnContent=""
                        OffContent=""
                        Margin="0,0,-100,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{DynamicResource Divider}" />



                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Pakete/s"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="KB/s"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="--"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="IP-Adresse"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <MaskedTextBox
                        Grid.Column="1"
                        Mask="###\.###\.###\.###"
                        PromptChar=" "
                        Text="127.000.000.001"
                        Foreground="{DynamicResource TextPrimary}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="Port"
                        Foreground="{DynamicResource TextSecondary}"
                        VerticalAlignment="Center" />
                    <MaskedTextBox
                        Grid.Column="1"
                        Mask="#####"
                        Text="10020"
                        Foreground="{DynamicResource TextPrimary}" />
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Feld 3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Feld 4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Feld 5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Feld 6" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
    </Grid>

</UserControl>